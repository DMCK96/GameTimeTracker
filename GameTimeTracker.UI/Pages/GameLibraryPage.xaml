<Page x:Class="GameTimeTracker.UI.Pages.GameLibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      Title="Game Library">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Game Library" 
                      FontSize="32" 
                      FontWeight="Bold"
                      VerticalAlignment="Center"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            
            <ui:Button Content="Add Game" 
                      Icon="{ui:SymbolIcon Add24}"
                      Appearance="Primary"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      IsEnabled="False"
                      ToolTip="Coming soon"/>
        </Grid>
        
        <!-- Game List -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <!-- Mock Game Entry -->
                <ui:Card Margin="0,0,0,15" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Game Icon/Thumbnail -->
                        <Border Grid.Column="0" 
                               Background="{DynamicResource ControlFillColorDefaultBrush}"
                               CornerRadius="8"
                               Width="80"
                               Height="80"
                               Margin="0,0,20,0">
                            <ui:SymbolIcon Symbol="Games24" 
                                          FontSize="40"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                        </Border>
                        
                        <!-- Game Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Test Game" 
                                      FontSize="20" 
                                      FontWeight="SemiBold"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ui:SymbolIcon Symbol="Clock24" 
                                              FontSize="16" 
                                              Margin="0,0,6,0"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="12.5 hours total" 
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,20,0"/>
                                
                                <ui:SymbolIcon Symbol="CalendarLtr24" 
                                              FontSize="16" 
                                              Margin="0,0,6,0"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="Last played: 2 days ago" 
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Background="{DynamicResource SystemFillColorAttentionBrush}"
                                       CornerRadius="4"
                                       Padding="8,4"
                                       Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Trophy24" 
                                                      FontSize="14" 
                                                      Margin="0,0,4,0"/>
                                        <TextBlock Text="5 day streak" 
                                                  FontSize="12"
                                                  FontWeight="SemiBold"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Actions -->
                        <StackPanel Grid.Column="2" 
                                   VerticalAlignment="Center"
                                   Orientation="Horizontal">
                            <ui:Button Icon="{ui:SymbolIcon Play24}"
                                      Appearance="Primary"
                                      Margin="0,0,10,0"
                                      ToolTip="Launch Game"
                                      IsEnabled="False"/>
                            
                            <ui:Button Icon="{ui:SymbolIcon MoreVertical24}"
                                      Appearance="Secondary"
                                      ToolTip="More Options"
                                      IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>
                
                <!-- Empty State Message (will be replaced with actual games) -->
                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                       BorderThickness="2"
                       CornerRadius="8"
                       Padding="40"
                       Margin="0,20,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Games24" 
                                      FontSize="48"
                                      Opacity="0.5"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,15"/>
                        
                        <TextBlock Text="No other games found" 
                                  FontSize="18"
                                  FontWeight="SemiBold"
                                  HorizontalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        
                        <TextBlock Text="The game shown above is a mock example. Game scanning and adding functionality will be implemented next." 
                                  HorizontalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                  TextWrapping="Wrap"
                                  TextAlignment="Center"
                                  MaxWidth="400"
                                  Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
