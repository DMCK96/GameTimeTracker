<ui:FluentWindow x:Class="GameTimeTracker.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:GameTimeTracker.UI"
        xmlns:pages="clr-namespace:GameTimeTracker.UI.Pages"
        mc:Ignorable="d"
        Title="GameTimeTracker" 
        Height="600" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0" 
                     Title="GameTimeTracker"
                     Icon="pack://application:,,,/Resources/icon.ico"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True"/>

        <!-- Navigation -->
        <ui:NavigationView Grid.Row="1"
                          x:Name="NavigationView"
                          IsBackButtonVisible="Collapsed"
                          IsPaneToggleVisible="True"
                          OpenPaneLength="200">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Game Library"
                                      Icon="{ui:SymbolIcon Games24}"
                                      TargetPageType="{x:Type pages:GameLibraryPage}"/>
            </ui:NavigationView.MenuItems>
            
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings"
                                      Icon="{ui:SymbolIcon Settings24}"
                                      TargetPageType="{x:Type pages:SettingsPage}"/>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>

